+    def HDEdgeY(self):
+        # 16:9: движок отдаёт мышь в своих единицах, Y-диапазон = h/s = 768*k < 768;
+        # родной канвасный порог screen_size[1]-1 = 766 в движковых единицах
+        # НЕДОСТИЖИМ -> нижний краевой скролл никогда не срабатывает (верх m==0,
+        # лево m==0, право m>w/s-2 достижимы: движковый X-диапазон = 0..1024 = ширина
+        # экрана). Порог = движковая координата нижнего края канваса, hd_scale.SY()
+        # (SY = k*v при F=1, identity при F=0). При k=1 SY identity -> побитово
+        # родный порог 766 (4:3-регрессия). try/except: правка не роняет апдейт.
+        try:
+            import hd_scale
+            return hd_scale.SY(self.screen_size[1] - 1)
+        except Exception:
+            return self.screen_size[1] - 1
+        return
+
