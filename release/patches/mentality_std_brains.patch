 import std_bstates, spells, whrandom, math, g_defs, units_base
+import formulas
 AI_LOGGING = 1
 
 def LOG(who, what):
     if AI_LOGGING:
         gamemodule.Log('% ' + who.unit.Name + ':' + what)
     return
+
+# Радиус агро (обнаружения) юнита в бою; задаёт план 10.2.
+AGGRO_RANGE_ALLY = 6.0
+AGGRO_RANGE_ENEMY = 8.0
+# Диагностика агро: пишет ld_aggro.log (строка в секунду на юнита) только при
+# наличии файла aggro.flag в корне игры (тот же приём, что blackbg.flag).
+AGGRO_LOG = 0
+_AGGRO_T = {}
+try:
+    _af = open('aggro.flag')
+    _af.close()
+    AGGRO_LOG = 1
+except:
+    pass
+
+def AggroLog(key, what):
+    if not AGGRO_LOG:
+        return
+    t = gamemodule.GetTime()
+    if t - _AGGRO_T.get(key, -1000.0) < 1.0:
+        return
+    _AGGRO_T[key] = t
+    try:
+        f = open('ld_aggro.log', 'a')
+        f.write('%.2f %s %s' % (t, str(key), str(what)) + chr(10))
+        f.close()
+    except:
+        pass
+    return
+
+def IsEnemyOwner(owner):
+    if owner == None:
+        return 0
+    if owner == overlandcharacters.Player:
+        return 0
+    p = overlandcharacters.Player
+    if p == None:
+        return 0
+    return owner.GroupID & p.GetOpponentSides() != 0
 
 
